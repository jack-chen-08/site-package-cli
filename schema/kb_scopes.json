{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sitepkg:schema:kb_scopes",
  "title": "kb_scopes.json —— 知识库可见范围（S6-PLAN-006）",
  "type": "object",
  "additionalProperties": false,
  "required": ["kb_scopes"],
  "properties": {
    "kb_scopes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kb_code", "name", "visibility", "space_codes"],
        "properties": {
          "kb_code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$"},
          "name": {"type": "string", "minLength": 2, "maxLength": 60},
          "visibility": {"type": "string", "enum": ["site", "role", "public"]},
          "space_codes": {
            "description": "可见范围绑定的空间编码，必须存在于本包 spaces.json；空数组表示不绑定具体空间",
            "type": "array",
            "maxItems": 200,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$"}
          }
        }
      }
    }
  }
}

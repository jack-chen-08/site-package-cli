{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sitepkg:schema:manifest",
  "title": "manifest.json —— 配置包清单（S6-PLAN-006）",
  "description": "配置包唯一入口文件，声明包版本与目标站点归属。site_code/org_code 必须与 site.json 一致。",
  "type": "object",
  "additionalProperties": false,
  "required": ["package_version", "org_code", "site_code", "created_at", "description"],
  "properties": {
    "package_version": {
      "description": "配置包版本号，与 site_code 共同构成 apply 的幂等键",
      "type": "string",
      "pattern": "^[0-9]{4}\\.[0-9]{2}\\.[0-9]{1,4}$",
      "examples": ["2026.11.0"]
    },
    "org_code": {
      "description": "组织编码（一期已存在）",
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
    },
    "site_code": {
      "description": "站点编码，在所属 org 下必须唯一",
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
    },
    "created_at": {
      "description": "打包时间，RFC3339",
      "type": "string",
      "format": "date-time"
    },
    "description": {
      "description": "包用途说明",
      "type": "string",
      "minLength": 4,
      "maxLength": 200
    }
  }
}

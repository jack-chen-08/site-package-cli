{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sitepkg:schema:price_book",
  "title": "price_book.json —— 价目表（S6-PLAN-006）",
  "description": "金额一律以「整数分」表示；unit_amount_fen 为 integer，出现 1234.56 这类小数视为金额非整数错误。",
  "type": "object",
  "additionalProperties": false,
  "required": ["currency", "price_items"],
  "properties": {
    "currency": {"type": "string", "enum": ["CNY"]},
    "price_items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["item_code", "name", "unit_amount_fen", "billing_period", "tax_included"],
        "properties": {
          "item_code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$"},
          "name": {"type": "string", "minLength": 2, "maxLength": 60},
          "unit_amount_fen": {
            "description": "单价，整数分，最小 0",
            "type": "integer",
            "minimum": 0,
            "maximum": 100000000
          },
          "billing_period": {"type": "string", "enum": ["month", "year", "once"]},
          "tax_included": {"type": "boolean"}
        }
      }
    }
  }
}

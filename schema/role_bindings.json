{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sitepkg:schema:role_bindings",
  "title": "role_bindings.json —— 角色与权限模板绑定（S6-PLAN-006）",
  "type": "object",
  "additionalProperties": false,
  "required": ["role_bindings"],
  "properties": {
    "role_bindings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role_code", "role_name", "permission_template_code", "scope"],
        "properties": {
          "role_code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$"},
          "role_name": {"type": "string", "minLength": 2, "maxLength": 40},
          "permission_template_code": {
            "description": "必须命中一期权限模板目录（catalog/permission_templates.json）",
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
          },
          "scope": {"type": "string", "enum": ["site", "space"]}
        }
      }
    }
  }
}

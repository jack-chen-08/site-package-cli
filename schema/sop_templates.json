{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sitepkg:schema:sop_templates",
  "title": "sop_templates.json —— SOP 模板启用（S6-PLAN-006）",
  "type": "object",
  "additionalProperties": false,
  "required": ["sop_templates"],
  "properties": {
    "sop_templates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["template_code", "version", "enabled", "channel"],
        "properties": {
          "template_code": {
            "description": "必须命中一期 SOP 模板目录（catalog/sop_templates.json）",
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
          },
          "version": {
            "description": "模板版本号，必须在该模板已发布版本列表中",
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
          },
          "enabled": {"type": "boolean"},
          "channel": {"type": "string", "enum": ["miniapp", "web", "all"]}
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sitepkg:schema:spaces",
  "title": "spaces.json —— 空间清单（S6-PLAN-006）",
  "type": "object",
  "additionalProperties": false,
  "required": ["spaces"],
  "properties": {
    "spaces": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["space_code", "name", "capacity", "reservation_rule_code", "enabled"],
        "properties": {
          "space_code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$"},
          "name": {"type": "string", "minLength": 2, "maxLength": 60},
          "capacity": {"type": "integer", "minimum": 1, "maximum": 100000},
          "reservation_rule_code": {
            "description": "必须命中一期预约规则目录（catalog/reservation_rules.json）",
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
          },
          "enabled": {"type": "boolean"}
        }
      }
    }
  }
}
